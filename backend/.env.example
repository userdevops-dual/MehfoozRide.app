# ─── Mehfooz Ride — Backend Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values

# ── MongoDB Atlas Connection ─────────────────────────────────────────────────
# Get free cluster at: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mehfoozride?retryWrites=true&w=majority

# ── JWT Auth Token ────────────────────────────────────────────────────────────
# Any long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRE=7d

# ── Server Port ───────────────────────────────────────────────────────────────
PORT=5000

# ── Demo vs real mode ─────────────────────────────────────────────────────────
# true  = SMS / police dispatch / payments are simulated and clearly labelled as demo
# false = production; requests that need an unconfigured service are refused
DEMO_MODE=true

# ── Phone OTP ─────────────────────────────────────────────────────────────────
# demo   = no SMS is sent; the app shows DEMO_OTP (only allowed when DEMO_MODE=true)
# twilio = real SMS with a random code (npm install twilio, then set the TWILIO_* values)
SMS_PROVIDER=demo
DEMO_OTP=123456
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
# TWILIO_PHONE=+1XXXXXXXXXX

# ── CNIC photo storage ────────────────────────────────────────────────────────
# local = private folder backend/uploads/private (not publicly served, git-ignored)
STORAGE_DRIVER=local

# ── Maps (free OpenStreetMap services, no API key) ────────────────────────────
# Public servers are for light/demo use only — point these at your own Nominatim
# and OSRM servers (or a compatible provider) for production.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# ROUTING_URL=https://router.project-osrm.org
# Contact e-mail sent in the User-Agent, as Nominatim's usage policy asks
# GEO_CONTACT_EMAIL=you@example.com

# ── Security (Phase 7) ──────────────────────────────────────────────────────
# production = stricter checks: weak JWT_SECRET refused, internal errors hidden, HSTS header
NODE_ENV=development
# Browser origins allowed to call the API (comma-separated). The mobile app needs none.
# CORS_ORIGINS=https://admin.your-domain.pk
# Development only: switch request rate limits off (ignored in production)
# RATE_LIMIT_DISABLED=true

# ── Emergency / SOS (Phase 5) ───────────────────────────────────────────────
# demo = contact SMS logged on the server; twilio = real SMS (needs the TWILIO_* values)
NOTIFY_PROVIDER=demo
# (uses the same TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_PHONE as OTP above)
# Official police/emergency endpoint, when one is available (incident payload is POSTed there)
# POLICE_API_URL=
# Public address of this server, so emergency contacts can open the live-location link
# PUBLIC_BASE_URL=https://api.your-domain.pk
# Overpass servers for nearby safe places (comma-separated; tried in order)
# OVERPASS_URL=https://overpass-api.de/api/interpreter