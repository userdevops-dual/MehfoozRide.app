# Mehfooz Ride app (frontend) settings — copy to .env and restart Metro with --clear.
# Only EXPO_PUBLIC_* values reach the app, and they are NOT secret (anyone can read
# them from the app) — never put API keys or passwords here; those belong in backend/.env.

# Backend server address.
#   Android emulator:            http://10.0.2.2:5000   (default when unset)
#   Real phone on the same Wi-Fi: http://<your computer's IP>:5000   (find it with: ipconfig)
#   Production:                  https://api.your-domain.pk
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:5000
